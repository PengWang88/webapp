<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>前端设计风格图鉴 · Design Atlas</title>
<style>
/* ============ 基础 ============ */
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

:root {
  --bg: #f4f5f7;
  --ink: #14161a;
  --muted: #6b7280;
  --line: #e2e4e9;
  --dark: #0e1014;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
               "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ============ 侧边栏 ============ */
.sidebar {
  position: fixed;
  top: 0; left: 0;
  width: 244px;
  height: 100vh;
  background: var(--dark);
  padding: 28px 18px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 26px;
  border-right: 1px solid rgba(255,255,255,.06);
  z-index: 100;
}
.brand {
  display: flex; align-items: center; gap: 10px;
  font-weight: 700; font-size: 14.5px; letter-spacing: .02em;
  color: #fff; padding-left: 8px;
}
.brand .dot {
  width: 9px; height: 9px; border-radius: 50%;
  background: #ff4d3d; box-shadow: 0 0 14px #ff4d3d;
  flex-shrink: 0;
}
.sidebar nav { display: flex; flex-direction: column; gap: 1px; }
.sidebar nav a {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 12px;
  border-radius: 8px;
  color: #8b93a3;
  text-decoration: none;
  font-size: 13.5px;
  transition: background .18s, color .18s;
}
.sidebar nav a .n {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10.5px; opacity: .5; width: 16px; flex-shrink: 0;
}
.sidebar nav a:hover { color: #fff; background: rgba(255,255,255,.06); }
.sidebar nav a.active { color: #fff; background: rgba(255,255,255,.1); }
.sidebar nav a.active .n { opacity: 1; color: #ff4d3d; }

.side-foot {
  margin-top: auto;
  font-size: 11.5px;
  line-height: 1.7;
  color: #4b5563;
  padding: 0 8px 8px;
  border-top: 1px solid rgba(255,255,255,.07);
  padding-top: 16px;
}

/* ============ 主区域 ============ */
.main { margin-left: 244px; }
.main-inner { max-width: 900px; margin: 0 auto; padding: 72px 48px 140px; }

.hero { padding-bottom: 44px; border-bottom: 1px solid var(--line); margin-bottom: 60px; }
.hero .kicker {
  display: inline-block;
  font-family: ui-monospace, monospace;
  font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
  color: var(--muted);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 5px 12px;
  margin-bottom: 22px;
  background: #fff;
}
.hero h1 {
  font-size: clamp(32px, 5vw, 54px);
  line-height: 1.03;
  letter-spacing: -.038em;
  font-weight: 800;
  margin: 0 0 20px;
}
.hero p {
  margin: 0;
  max-width: 560px;
  font-size: 15.5px;
  line-height: 1.8;
  color: var(--muted);
}

/* ============ 区块 ============ */
.style-block {
  margin-bottom: 92px;
  scroll-margin-top: 32px;
}
.block-head {
  display: flex; align-items: baseline; gap: 14px;
  flex-wrap: wrap; margin-bottom: 16px;
}
.num {
  font-family: ui-monospace, monospace;
  font-size: 11.5px;
  color: var(--muted);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 3px 8px;
  background: #fff;
}
.style-block h2 {
  margin: 0;
  font-size: 25px;
  letter-spacing: -.022em;
  font-weight: 700;
}
.style-block h2 em {
  font-style: normal;
  font-weight: 400;
  font-size: 15px;
  color: var(--muted);
  margin-left: 10px;
  letter-spacing: 0;
}
.desc {
  margin: 0 0 18px;
  max-width: 680px;
  font-size: 14.5px;
  line-height: 1.8;
  color: #4b5563;
}
.tags {
  display: flex; flex-wrap: wrap; gap: 8px;
  list-style: none; margin: 0 0 26px; padding: 0;
}
.tags li {
  font-size: 12px;
  color: #374151;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 5px 12px;
}

/* ============ 演示容器（通用） ============ */
.demo {
  position: relative;
  overflow: hidden;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24px;
  padding: 56px 32px;
  min-height: 330px;
  box-shadow: 0 1px 2px rgba(0,0,0,.05), 0 16px 40px -18px rgba(0,0,0,.22);
}

/* ============ 说明卡片 ============ */
.notes {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 20px;
}
.note {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 16px 18px;
}
.note h4 {
  margin: 0 0 7px;
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 600;
}
.note p { margin: 0; font-size: 13.5px; line-height: 1.7; color: #374151; }

.codebar {
  margin-top: 14px;
  background: var(--dark);
  color: #a5f3fc;
  border-radius: 10px;
  padding: 13px 18px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12.5px;
  overflow-x: auto;
  white-space: nowrap;
}
.codebar::before {
  content: "CSS";
  color: #4b5563;
  margin-right: 14px;
  font-weight: 700;
  letter-spacing: .1em;
}
/* =========================================================
   01 新拟态 Neumorphism
   ========================================================= */
.neumo { background: #e0e5ec; }
.neumo-card {
  width: min(400px, 100%);
  background: #e0e5ec;
  border-radius: 28px;
  padding: 30px;
  color: #4a5568;
  box-shadow: 12px 12px 28px #b9c1cc, -12px -12px 28px #ffffff;
}
.neumo-card h3 { margin: 0 0 6px; font-size: 19px; color: #3a4453; letter-spacing: -.01em; }
.neumo-sub { margin: 0 0 26px; font-size: 12.5px; color: #8792a3; }
.neumo-ctrls { display: flex; align-items: center; justify-content: center; gap: 18px; margin-bottom: 26px; }
.neumo-btn {
  border: none; cursor: pointer;
  background: #e0e5ec; color: #5a6478;
  width: 52px; height: 52px;
  border-radius: 16px;
  font-size: 16px; font-family: inherit;
  box-shadow: 7px 7px 14px #b9c1cc, -7px -7px 14px #ffffff;
  transition: box-shadow .18s ease, transform .18s ease;
}
.neumo-btn:hover { transform: translateY(-1px); }
.neumo-btn:active { box-shadow: inset 6px 6px 12px #b9c1cc, inset -6px -6px 12px #ffffff; }
.neumo-btn--round { width: 64px; height: 64px; border-radius: 50%; font-size: 17px; }
.neumo-btn--inset { box-shadow: inset 6px 6px 12px #b9c1cc, inset -6px -6px 12px #ffffff; }
.neumo-slider {
  height: 10px; border-radius: 6px; margin-bottom: 22px;
  background: #e0e5ec;
  box-shadow: inset 3px 3px 6px #b9c1cc, inset -3px -3px 6px #ffffff;
  overflow: hidden;
}
.neumo-slider-fill {
  width: 62%; height: 100%; border-radius: 6px;
  background: linear-gradient(90deg, #a9b7cc, #8fa2bd);
}
.neumo-input {
  width: 100%; border: none; outline: none;
  background: #e0e5ec; color: #4a5568;
  padding: 14px 18px; border-radius: 14px;
  font-size: 13.5px; font-family: inherit;
  box-shadow: inset 5px 5px 10px #b9c1cc, inset -5px -5px 10px #ffffff;
}
.neumo-input::placeholder { color: #9aa4b5; }

/* =========================================================
   02 玻璃拟态 Glassmorphism
   ========================================================= */
.glass { background: linear-gradient(135deg, #5b21b6 0%, #2563eb 45%, #ec4899 100%); }
.glass-orb { position: absolute; border-radius: 50%; filter: blur(46px); }
.glass-orb--1 { width: 220px; height: 220px; background: #22d3ee; top: -50px; left: -40px; }
.glass-orb--2 { width: 260px; height: 260px; background: #f472b6; bottom: -70px; right: -50px; }
.glass-orb--3 { width: 170px; height: 170px; background: #facc15; top: 28%; right: 22%; opacity: .55; }
.glass-card {
  position: relative; z-index: 1;
  width: min(380px, 100%);
  padding: 28px;
  border-radius: 24px;
  color: #fff;
  background: rgba(255,255,255,.14);
  border: 1px solid rgba(255,255,255,.35);
  backdrop-filter: blur(18px) saturate(170%);
  -webkit-backdrop-filter: blur(18px) saturate(170%);
  box-shadow: 0 8px 32px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.35);
}
.glass-badge {
  display: inline-block;
  font-size: 10px; font-weight: 700; letter-spacing: .14em;
  padding: 4px 10px; border-radius: 999px;
  background: rgba(255,255,255,.22);
  border: 1px solid rgba(255,255,255,.35);
  margin-bottom: 16px;
}
.glass-card h3 { margin: 0 0 10px; font-size: 21px; letter-spacing: -.02em; }
.glass-card p { margin: 0 0 20px; font-size: 13px; line-height: 1.7; color: rgba(255,255,255,.82); }
.glass-stats { display: flex; gap: 32px; margin-bottom: 22px; }
.glass-stats strong { display: block; font-size: 22px; letter-spacing: -.02em; }
.glass-stats span { font-size: 11px; color: rgba(255,255,255,.62); letter-spacing: .06em; text-transform: uppercase; }
.glass-btn {
  width: 100%;
  font-family: inherit; font-size: 13px; font-weight: 600;
  padding: 12px; border-radius: 12px; cursor: pointer;
  color: #fff;
  background: rgba(255,255,255,.18);
  border: 1px solid rgba(255,255,255,.4);
  transition: background .2s;
}
.glass-btn:hover { background: rgba(255,255,255,.3); }

/* =========================================================
   03 新粗野主义 Neubrutalism
   ========================================================= */
.neubrutal { background: #ffd93d; }
.nb-card {
  position: relative;
  width: min(360px, 100%);
  background: #fff;
  border: 4px solid #000;
  padding: 28px;
  box-shadow: 10px 10px 0 #000;
}
.nb-tag {
  position: absolute; top: -15px; right: 16px;
  background: #00e0b8;
  border: 3px solid #000;
  font-size: 11px; font-weight: 900; letter-spacing: .1em;
  padding: 2px 10px;
  transform: rotate(-4deg);
}
.nb-card h3 {
  margin: 0 0 12px;
  font-size: 31px; line-height: .95; font-weight: 900;
  letter-spacing: -.025em; text-transform: uppercase;
}
.nb-card p { margin: 0 0 22px; font-size: 13px; font-weight: 700; color: #444; }
.nb-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.nb-btn {
  font-family: inherit; font-size: 12.5px; font-weight: 900;
  letter-spacing: .06em;
  padding: 11px 18px;
  border: 3px solid #000;
  cursor: pointer;
  box-shadow: 4px 4px 0 #000;
  transition: transform .08s, box-shadow .08s;
}
.nb-btn:active { transform: translate(4px, 4px); box-shadow: 0 0 0 #000; }
.nb-btn--pink { background: #ff5c8a; color: #000; }
.nb-btn--white { background: #fff; color: #000; }

/* =========================================================
   04 拟物化 Skeuomorphism
   ========================================================= */
.skeuo {
  background: #4a4238;
  background-image:
    repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 3px),
    repeating-linear-gradient(90deg, rgba(0,0,0,.09) 0 1px, transparent 1px 3px);
}
.skeuo-panel {
  width: min(380px, 100%);
  padding: 10px;
  border-radius: 14px;
  border: 1px solid #b8b2a6;
  background: linear-gradient(#f7f5f1, #e6e2da);
  box-shadow:
    inset 0 1px 0 #fff,
    0 2px 0 #cbc5b8,
    0 20px 44px rgba(0,0,0,.55);
}
.skeuo-screen {
  padding: 20px;
  border-radius: 9px;
  border: 1px solid #d5d0c6;
  background: linear-gradient(#fdfcfa, #f0ede7);
  box-shadow: inset 0 2px 6px rgba(0,0,0,.14), inset 0 -1px 0 #fff;
  margin-bottom: 10px;
}
.skeuo-screen h3 {
  margin: 0 0 14px;
  font-size: 15px;
  color: #3d3a34;
  text-shadow: 0 1px 0 #fff;
  letter-spacing: .01em;
}
.skeuo-list { display: flex; flex-direction: column; gap: 9px; }
.skeuo-item {
  display: flex; align-items: center; gap: 10px;
  font-size: 12.5px; color: #55504a;
  padding: 8px 10px;
  border-radius: 6px;
  background: #fff;
  box-shadow: inset 0 1px 0 #fff, 0 1px 2px rgba(0,0,0,.08);
}
.skeuo-check {
  width: 15px; height: 15px; border-radius: 4px; flex-shrink: 0;
  background: linear-gradient(#f2efe9, #dcd7cc);
  border: 1px solid #b0a99c;
  box-shadow: inset 0 1px 0 #fff;
}
.skeuo-check--on {
  background: linear-gradient(#6fb3f0, #2f7fd0);
  border-color: #1f5f9f;
  box-shadow: inset 0 1px 2px rgba(0,0,0,.35);
}
.skeuo-btns { display: flex; gap: 8px; justify-content: flex-end; padding: 0 2px 2px; }
.skeuo-btn {
  font-family: inherit; font-size: 12.5px; font-weight: 600;
  color: #3d3a34; cursor: pointer;
  padding: 9px 18px;
  border-radius: 8px;
  border: 1px solid #a8a294;
  background: linear-gradient(#ffffff, #dcd7cc);
  box-shadow: inset 0 1px 0 #fff, inset 0 -2px 3px rgba(0,0,0,.12), 0 1px 2px rgba(0,0,0,.3);
  text-shadow: 0 1px 0 rgba(255,255,255,.8);
}
.skeuo-btn:active {
  background: linear-gradient(#dcd7cc, #ffffff);
  box-shadow: inset 0 2px 4px rgba(0,0,0,.25);
}
.skeuo-btn--primary {
  color: #fff;
  background: linear-gradient(#6fb3f0, #2f7fd0);
  border-color: #1f5f9f;
  text-shadow: 0 -1px 0 rgba(0,0,0,.35);
}
.skeuo-btn--primary:active { background: linear-gradient(#2f7fd0, #6fb3f0); }